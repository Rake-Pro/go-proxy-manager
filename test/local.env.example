# test/local.env.example
#
# Committed template for overridable knobs used by live/integration test
# scripts (e.g. test/stream/test.sh). Values here are synthetic (RFC 5737
# example addresses) — safe to publish.
#
# To use your own real infra for a local/live run:
#   cp test/local.env.example test/local.env
#   edit test/local.env with your real values
#
# test/local.env is gitignored and never committed; scripts fall back to the
# synthetic defaults below when it is absent.

# STREAM_TEST_HOST/PORT: target for the stream-host echo harness
# (test/stream/test.sh). Defaults to the local docker-compose loopback;
# override to hit a real homelab host that has the stream port published.
STREAM_TEST_HOST=192.0.2.10
STREAM_TEST_PORT=15432
