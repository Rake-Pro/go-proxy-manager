# go-proxy-manager parallel-test secrets. Copy to deploy/.env and fill in.
# .env is gitignored; never commit real values. Values are read literally
# (env_file, no interpolation), so the bcrypt $-signs below are safe.

# Break-glass / local admin password hash. Generate with the binary:
#   docker run --rm ghcr.io/rake-pro/go-proxy-manager:main hashpw '<password>'
GPM_LOCAL_ADMIN_PASSWORD_HASH=

# Cloudflare API token for ACME DNS-01 (only needed to test live issuance;
# use Let's Encrypt staging first).
CF_API_TOKEN=
